{
  "id": "cicids2017-v1",
  "version": 1,
  "description": "CICFlowMeter-style flow statistics as found in CICIDS2017 CSV exports. Used by the benchmark model only; live collector traffic uses sentinel-native-v1.",
  "missingValuePolicy": "Non-finite values (NaN, Infinity, empty) are stored as null and imputed with the training median by the model pipeline. A feature key that is absent from a flow is a contract error and is rejected.",
  "excluded": {
    "Flow ID": "identifier (leaks the 5-tuple)",
    "Source IP": "identifier",
    "Destination IP": "identifier",
    "Source Port": "ephemeral identifier",
    "Destination Port": "excluded to limit shortcut learning on the 2017 testbed's fixed service ports",
    "Timestamp": "identifier; testbed schedule leaks the label",
    "Fwd Header Length": "duplicated column in the original CICIDS2017 CSVs (known data error)",
    "Label": "ground truth, evaluation only"
  },
  "features": [
    { "name": "Flow Duration", "dtype": "float", "unit": "microseconds" },
    { "name": "Total Fwd Packets", "dtype": "float", "unit": "packets" },
    { "name": "Total Backward Packets", "dtype": "float", "unit": "packets" },
    { "name": "Total Length of Fwd Packets", "dtype": "float", "unit": "bytes" },
    { "name": "Total Length of Bwd Packets", "dtype": "float", "unit": "bytes" },
    { "name": "Fwd Packet Length Max", "dtype": "float", "unit": "bytes" },
    { "name": "Fwd Packet Length Min", "dtype": "float", "unit": "bytes" },
    { "name": "Fwd Packet Length Mean", "dtype": "float", "unit": "bytes" },
    { "name": "Fwd Packet Length Std", "dtype": "float", "unit": "bytes" },
    { "name": "Bwd Packet Length Max", "dtype": "float", "unit": "bytes" },
    { "name": "Bwd Packet Length Min", "dtype": "float", "unit": "bytes" },
    { "name": "Bwd Packet Length Mean", "dtype": "float", "unit": "bytes" },
    { "name": "Bwd Packet Length Std", "dtype": "float", "unit": "bytes" },
    { "name": "Flow Bytes/s", "dtype": "float", "unit": "bytes/s" },
    { "name": "Flow Packets/s", "dtype": "float", "unit": "packets/s" },
    { "name": "Flow IAT Mean", "dtype": "float", "unit": "microseconds" },
    { "name": "Flow IAT Std", "dtype": "float", "unit": "microseconds" },
    { "name": "Flow IAT Max", "dtype": "float", "unit": "microseconds" },
    { "name": "Flow IAT Min", "dtype": "float", "unit": "microseconds" },
    { "name": "Fwd IAT Total", "dtype": "float", "unit": "microseconds" },
    { "name": "Fwd IAT Mean", "dtype": "float", "unit": "microseconds" },
    { "name": "Bwd IAT Total", "dtype": "float", "unit": "microseconds" },
    { "name": "Bwd IAT Mean", "dtype": "float", "unit": "microseconds" },
    { "name": "Fwd PSH Flags", "dtype": "float", "unit": "count" },
    { "name": "Fwd Packets/s", "dtype": "float", "unit": "packets/s" },
    { "name": "Bwd Packets/s", "dtype": "float", "unit": "packets/s" },
    { "name": "Min Packet Length", "dtype": "float", "unit": "bytes" },
    { "name": "Max Packet Length", "dtype": "float", "unit": "bytes" },
    { "name": "Packet Length Mean", "dtype": "float", "unit": "bytes" },
    { "name": "Packet Length Std", "dtype": "float", "unit": "bytes" },
    { "name": "FIN Flag Count", "dtype": "float", "unit": "count" },
    { "name": "SYN Flag Count", "dtype": "float", "unit": "count" },
    { "name": "RST Flag Count", "dtype": "float", "unit": "count" },
    { "name": "PSH Flag Count", "dtype": "float", "unit": "count" },
    { "name": "ACK Flag Count", "dtype": "float", "unit": "count" },
    { "name": "URG Flag Count", "dtype": "float", "unit": "count" },
    { "name": "Down/Up Ratio", "dtype": "float", "unit": "ratio" },
    { "name": "Average Packet Size", "dtype": "float", "unit": "bytes" },
    { "name": "Init_Win_bytes_forward", "dtype": "float", "unit": "bytes" },
    { "name": "Init_Win_bytes_backward", "dtype": "float", "unit": "bytes" },
    { "name": "act_data_pkt_fwd", "dtype": "float", "unit": "packets" },
    { "name": "min_seg_size_forward", "dtype": "float", "unit": "bytes" },
    { "name": "Active Mean", "dtype": "float", "unit": "microseconds" },
    { "name": "Idle Mean", "dtype": "float", "unit": "microseconds" }
  ]
}
