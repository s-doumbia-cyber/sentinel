{
  "name": "@sentinel/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Sentinel contracts: attack taxonomy, label normaliser, severity and MITRE maps, feature schemas, zod schemas.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./feature-schemas/*": "./src/feature-schemas/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
