# Copy to apps/api/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB (local install, Docker, or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sentinel

# Access-token signing secret: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 for local development).
TRUST_PROXY=0

# ML service (services/ml). Without it, flows are stored but stay unscored.
ML_SERVICE_URL=http://127.0.0.1:8000
# Optional shared secret sent as X-Internal-Token; must match services/ml.
ML_SERVICE_TOKEN=

UPLOAD_MAX_MB=500
# Where uploads wait for their import job (default: the OS temp directory).
UPLOAD_DIR=

# Durable job queue (BullMQ). Leave empty to run jobs inside the API process
# (they then do not survive a restart). Example: redis://127.0.0.1:6379
REDIS_URL=
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# false: this process only enqueues; run `npm run start:worker -w @sentinel/api` for the workers.
RUN_WORKERS=true
